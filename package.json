{
  "name": "rbx-fashion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser-chromium --project browser-smoke",
    "check:bundle": "node scripts/check-bundle.mjs",
    "calibration:fixtures": "node --experimental-strip-types scripts/generate-calibration.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:e2e": "playwright test",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "preact": "10.29.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "playwright": "1.62.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
